<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Extend existing demo booking type with note and image -->
    <record
        id="resource_booking.resource_booking_type_customer"
        model="resource.booking.type"
    >
        <field
            name="note"
        >This appointment type is intended for general customer meetings. Provide any extra context that helps us prepare.</field>
        <field
            name="image_1920"
            type="base64"
            file="base/static/img/res_company_logo.png"
        />
        <field name="location">Head Office - Conference Room A</field>
        <field
            name="videocall_location"
        >https://meet.example.com/customer-meeting</field>
    </record>
</odoo>
