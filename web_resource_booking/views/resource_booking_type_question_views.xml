<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="resource_booking_type_view_form_inherit_questions" model="ir.ui.view">
        <field name="name">resource.booking.type.form.inherit.questions</field>
        <field name="model">resource.booking.type</field>
        <field
            name="inherit_id"
            ref="resource_booking.resource_booking_type_view_form"
        />
        <field name="arch" type="xml">
            <!-- Add type image as avatar above title -->
            <xpath expr="//sheet/div[@class='oe_title']" position="before">
                <field name="image_1920" widget="image" class="oe_avatar" />
            </xpath>
            <!-- Add Note field inside meeting defaults group -->
            <xpath expr="//group[@name='event_defaults']" position="inside">
                <field name="note" />
            </xpath>
            <xpath expr="//group[@name='combinations']" position="after">
                <group name="questions" string="Questions for requesters" colspan="2">
                    <field name="question_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle" />
                            <field name="name" />
                            <field name="field_type" />
                            <field name="required" />
                            <field name="help" />
                            <field name="active" />
                        </list>
                        <form string="Question">
                            <group>
                                <field name="sequence" />
                                <field name="name" />
                                <field name="field_type" />
                                <field name="required" />
                                <field name="help" />
                                <field name="active" />
                            </group>
                            <group
                                attrs="{'invisible': [('field_type', '!=', 'select')]}"
                                string="Options"
                            >
                                <field name="option_ids">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle" />
                                        <field name="name" />
                                    </list>
                                </field>
                            </group>
                        </form>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
