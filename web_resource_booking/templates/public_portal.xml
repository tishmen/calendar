<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="rbooking_type_select" name="RBooking: One-Page Form">
        <t t-call="portal.portal_layout">
            <t t-set="no_breadcrumbs" t-value="True" />
            <div id="wrap" class="container mt-4">
                <div class="mx-auto" style="max-width: 600px;">
                    <h2>Book an Appointment</h2>
                    <!-- Step indicator: 1) Your Info 2) Schedule 3) Confirmation -->
                    <div class="o_rbooking_steps d-flex align-items-center gap-3 my-3">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge rounded-pill bg-primary">1</span>
                            <span class="fw-semibold">Your Information</span>
                        </div>
                        <div class="flex-grow-1 border-top" style="opacity:.25;" />
                        <div class="d-flex align-items-center gap-2 text-muted">
                            <span
                                class="badge rounded-pill bg-light text-muted border"
                            >2</span>
                            <span>Schedule</span>
                        </div>
                        <div class="flex-grow-1 border-top" style="opacity:.25;" />
                        <div class="d-flex align-items-center gap-2 text-muted">
                            <span
                                class="badge rounded-pill bg-light text-muted border"
                            >3</span>
                            <span>Confirmation</span>
                        </div>
                    </div>
                    <div
                        id="rbooking-app"
                        data-users-endpoint="/rbooking/users"
                        data-questions-endpoint="/rbooking/questions"
                        t-att-data-preselected-type-id="preselected_type_id or ''"
                        t-att-data-preselected-user-id="preselected_user_id or ''"
                    >
                        <select id="rbooking-types-data" class="d-none">
                            <t t-foreach="types" t-as="t">
                                <option
                                    t-att-value="t.id"
                                    t-att-data-name="t.display_name"
                                    t-att-data-note="t.note or ''"
                                    t-att-data-location="t.location or ''"
                                    t-att-data-slug="t.slug or ''"
                                    t-attf-data-image="/web/image/resource.booking.type/#{t.id}/image_1920"
                                />
                            </t>
                        </select>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
